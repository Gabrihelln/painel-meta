# Copie este arquivo para .env.local (no seu PC) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
# Sem SUPABASE_URL o painel abre em modo demonstração, com dados de exemplo.

# Senha para entrar no painel
PAINEL_SENHA=
# Texto aleatório longo (assina o cookie de login). Ex.: gere em https://1password.com/password-generator
AUTH_SECRET=

# Supabase: URL em Integrations > Data API; chave secreta (sb_secret_...) em Project Settings > API Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Token que você cadastra no webhook da Wiapy (invente um texto aleatório e use o mesmo nos dois lugares)
WIAPY_WEBHOOK_TOKEN=

# Meta Ads
META_ACCESS_TOKEN=
# Uma ou mais contas, separadas por vírgula. Ex.: act_1234567890,act_9876543210
META_AD_ACCOUNT_IDS=
META_API_VERSION=v24.0

# Protege a rota que sincroniza o Meta (usado pela Vercel Cron e pelo GitHub Actions)
CRON_SECRET=

# Força o modo demonstração mesmo com Supabase configurado (1 = ligado)
DEMO_MODE=
